;desired_start&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;DATE&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;&quot;&gt;&lt;td style=&quot;width:44px;color:#444;font-weight:bold&quot;&gt;&lt;/td&gt;&lt;td style=&quot;width:128px&quot;&gt;months&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;TINYINT&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;1–60&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;&quot;&gt;&lt;td style=&quot;width:44px;color:#444;font-weight:bold&quot;&gt;&lt;/td&gt;&lt;td style=&quot;width:128px&quot;&gt;message&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;VARCHAR(500)&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;&quot;&gt;&lt;td style=&quot;width:44px;color:#444;font-weight:bold&quot;&gt;&lt;/td&gt;&lt;td style=&quot;width:128px&quot;&gt;status&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;VARCHAR(20)&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;= 'PENDING'&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;&quot;&gt;&lt;td style=&quot;width:44px;color:#444;font-weight:bold&quot;&gt;&lt;/td&gt;&lt;td style=&quot;width:128px&quot;&gt;decided_at&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;&quot;&gt;&lt;td style=&quot;width:44px;color:#444;font-weight:bold&quot;&gt;&lt;/td&gt;&lt;td style=&quot;width:128px&quot;&gt;created_at&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;DATETIME&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;= now&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;font-style:italic;color:#777777;&quot;&gt;&lt;td style=&quot;width:44px;color:#444;font-weight:bold&quot;&gt;GEN&lt;/td&gt;&lt;td style=&quot;width:128px&quot;&gt;pending_key&lt;/td&gt;&lt;td style=&quot;width:92px;color:#555&quot;&gt;VARCHAR(30)&lt;/td&gt;&lt;td style=&quot;color:#555;white-space:nowrap&quot;&gt;unique when PENDING&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="t17"><mxGeometry y="38" width="400" height="182.8" as="geometry"/></mxCell>
