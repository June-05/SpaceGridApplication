Color=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="row58" target="row38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1587" y="483.0"/><mxPoint x="1587" y="879.0"/></Array></mxGeometry></mxCell><mxCell id="rel95" value="renews" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#444444;startArrow=ERzeroToOne;startFill=0;startSize=12;endArrow=ERzeroToOne;endFill=0;endSize=12;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="row60" target="row57"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1564" y="527.0"/><mxPoint x="1564" y="461.0"/></Array></mxGeometry></mxCell><mxCell id="rel96" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#444444;startArrow=ERzeroToMany;startFill=0;startSize=12;endArrow=ERmandOne;endFill=0;endSize=12;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="row69" target="row57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="box97" value="Rules enforced by the database" style="swimlane;shape=swimlane;html=1;startSize=30;align=left;spacingLeft=10;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#e9e9e9;fontColor=#1a1a1a;swimlaneFillColor=#ffffff;strokeColor=#e9e9e9;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="1232" width="2078" height="288" as="geometry"/></mxCell><mxCell id="t98" value="• &lt;b&gt;zone_cells&lt;/b&gt; PK (property_id, row_idx, col_idx): one zone per spot. Composite FK (zone_id, property_id) → grid_zones (id, property_id): the zone must be from the same property." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="42" width="2046" height="28" as="geometry"/></mxCell><mxCell id="t99" value="• &lt;b&gt;lease_contracts.active_unit_id&lt;/b&gt; = rentable_unit_id while status = 'ACTIVE', otherwise NULL. UNIQUE: one ACTIVE lease per unit." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="70" width="2046" height="28" as="geometry"/></mxCell><mxCell id="t100" value="• &lt;b&gt;payments.paid_lease_id&lt;/b&gt; = lease_id while status = 'PAID'. UNIQUE (paid_lease_id, billing_month): a month is paid only once; FAILED attempts can repeat." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="98" width="2046" height="28" as="geometry"/></mxCell><mxCell id="t101" value="• &lt;b&gt;previous_lease_id&lt;/b&gt; UNIQUE: a lease can be renewed only once." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="126" width="2046" height="28" as="geometry"/></mxCell><mxCell id="t102" value="• &lt;b&gt;ON DELETE CASCADE:&lt;/b&gt; property → zones → units / common areas / cells, and property → edge_overrides.  &lt;b&gt;RESTRICT:&lt;/b&gt; users, units with leases (archive instead), leases with payments." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="154" width="2046" height="28" as="geometry"/></mxCell><mxCell id="t103" value="• &lt;b&gt;CHECK values:&lt;/b&gt; role LANDLORD|RENTER · property_type APARTMENT|CONDOMINIUM|TOWNHOUSE|COMMERCIAL · property status DRAFT|ACTIVE|ARCHIVED · unit status AVAILABLE|OCCUPIED|UNDER_MAINTENANCE|ARCHIVED · area_type WALKWAY|GRASS|BATHROOM|KITCHEN|LAUNDRY|LOBBY|PARKING|STAIRS · edge_type WALL|DOOR|WINDOW|OPEN · lease status ACTIVE|ENDED|TERMINATED|RENEWED · method GCASH|MAYA|CARD · payment status PENDING|PAID|FAILED." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="182" width="2046" height="46" as="geometry"/></mxCell><mxCell id="t104" value="• &lt;b&gt;Size columns&lt;/b&gt; (Dimensions): is_exact_size NULL = no size; TRUE needs area_sqm; FALSE needs size_description. &lt;b&gt;closed_on&lt;/b&gt; is NULL only while the lease is ACTIVE. &lt;b&gt;PAID&lt;/b&gt; payments need reference_no and paid_at." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="228" width="2046" height="28" as="geometry"/></mxCell><mxCell id="t105" value="• &lt;b&gt;Not stored&lt;/b&gt; (calculated in Java): automatic walls, LeaseState, DueStatus, RentDue, PaymentResult." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box97"><mxGeometry x="16" y="256" width="2046" height="28" as="geometry"/></mxCell><mxCell id="box106" value="Legend" style="swimlane;shape=swimlane;html=1;startSize=30;align=left;spacingLeft=10;verticalAlign=top;fontSize=14;fontStyle=1;fillColor=#333333;fontColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#333333;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2188" y="130" width="470" height="704" as="geometry"/></mxCell><mxCell id="t107" value="&lt;b&gt;1. Categories (header color)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="box106"><mxGeometry x="16" y="42" width="438" height="20" as="geometry"/></mxCell><mxCell id="r108" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="box106"><mxGeometry x="16" y="68" width="26" height="16" as="geometry"/></mxCell><mxCell id="t109" value="&lt;b&gt;Accounts&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="52" y="66" width="140" height="30" as="geometry"/></mxCell><mxCell id="t110" value="Who uses the system (landlords and renters)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="190" y="66" width="264" height="32" as="geometry"/></mxCell><mxCell id="r111" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="box106"><mxGeometry x="16" y="104" width="26" height="16" as="geometry"/></mxCell><mxCell id="t112" value="&lt;b&gt;Properties &amp;amp; grid&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="52" y="102" width="140" height="30" as="geometry"/></mxCell><mxCell id="t113" value="Properties, their zones (units and common areas), plotted spots and wall edits." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="190" y="102" width="264" height="32" as="geometry"/></mxCell><mxCell id="r114" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="box106"><mxGeometry x="16" y="140" width="26" height="16" as="geometry"/></mxCell><mxCell id="t115" value="&lt;b&gt;Leasing &amp;amp; payments&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="52" y="138" width="140" height="30" as="geometry"/></mxCell><mxCell id="t116" value="Lease contracts, renewals and monthly rent payments." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="190" y="138" width="264" height="32" as="geometry"/></mxCell><mxCell id="r117" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="box106"><mxGeometry x="16" y="176" width="26" height="16" as="geometry"/></mxCell><mxCell id="t118" value="&lt;b&gt;View&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="52" y="174" width="140" height="30" as="geometry"/></mxCell><mxCell id="t119" value="A saved SELECT (not a real table) used by the lease screens." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="190" y="174" width="264" height="32" as="geometry"/></mxCell><mxCell id="t120" value="&lt;b&gt;2. Crow's foot (relationship ends)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="box106"><mxGeometry x="16" y="216" width="438" height="20" as="geometry"/></mxCell><mxCell id="le121" value="" style="html=1;rounded=0;strokeColor=#444444;startArrow=ERmandOne;startFill=0;startSize=12;endArrow=none;endFill=0;endSize=12;" edge="1" parent="box106"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="250" as="sourcePoint"/><mxPoint x="18" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t122" value="&lt;b&gt;Exactly one&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="86" y="240" width="110" height="30" as="geometry"/></mxCell><mxCell id="t123" value="The parent row (the PK side)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="196" y="240" width="258" height="30" as="geometry"/></mxCell><mxCell id="le124" value="" style="html=1;rounded=0;strokeColor=#444444;startArrow=ERzeroToOne;startFill=0;startSize=12;endArrow=none;endFill=0;endSize=12;" edge="1" parent="box106"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="280" as="sourcePoint"/><mxPoint x="18" y="280" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t125" value="&lt;b&gt;Zero or one&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="86" y="270" width="110" height="30" as="geometry"/></mxCell><mxCell id="t126" value="e.g. a zone has 0..1 unit row." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="196" y="270" width="258" height="30" as="geometry"/></mxCell><mxCell id="le127" value="" style="html=1;rounded=0;strokeColor=#444444;startArrow=ERzeroToMany;startFill=0;startSize=12;endArrow=none;endFill=0;endSize=12;" edge="1" parent="box106"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="310" as="sourcePoint"/><mxPoint x="18" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t128" value="&lt;b&gt;Zero or many&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="86" y="300" width="110" height="30" as="geometry"/></mxCell><mxCell id="t129" value="e.g. a property has 0..* zones." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="196" y="300" width="258" height="30" as="geometry"/></mxCell><mxCell id="le130" value="" style="html=1;rounded=0;strokeColor=#444444;startArrow=ERoneToMany;startFill=0;startSize=12;endArrow=none;endFill=0;endSize=12;" edge="1" parent="box106"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="340" as="sourcePoint"/><mxPoint x="18" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t131" value="&lt;b&gt;One or many&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="86" y="330" width="110" height="30" as="geometry"/></mxCell><mxCell id="t132" value="At least one." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="196" y="330" width="258" height="30" as="geometry"/></mxCell><mxCell id="t133" value="Lines run from the foreign-key column (FK) to the primary key (PK) it points to." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="16" y="360" width="438" height="34" as="geometry"/></mxCell><mxCell id="t134" value="&lt;b&gt;3. Column keys&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="box106"><mxGeometry x="16" y="400" width="438" height="20" as="geometry"/></mxCell><mxCell id="t135" value="&lt;b&gt;PK&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="424" width="64" height="20" as="geometry"/></mxCell><mxCell id="t136" value="Primary key (bold). Several PK rows = composite key." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="424" width="374" height="30" as="geometry"/></mxCell><mxCell id="t137" value="&lt;b&gt;FK&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="448" width="64" height="20" as="geometry"/></mxCell><mxCell id="t138" value="Foreign key: points to another table's PK." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="448" width="374" height="30" as="geometry"/></mxCell><mxCell id="t139" value="&lt;b&gt;PK FK&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="472" width="64" height="20" as="geometry"/></mxCell><mxCell id="t140" value="Both: shares the parent's id (inheritance rows, composite keys)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="472" width="374" height="30" as="geometry"/></mxCell><mxCell id="t141" value="&lt;b&gt;UQ&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="496" width="64" height="20" as="geometry"/></mxCell><mxCell id="t142" value="Unique: no two rows can have the same value." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="496" width="374" height="30" as="geometry"/></mxCell><mxCell id="t143" value="&lt;b&gt;GEN&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="520" width="64" height="20" as="geometry"/></mxCell><mxCell id="t144" value="Generated: calculated by the database (italic)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="520" width="374" height="30" as="geometry"/></mxCell><mxCell id="t145" value="&lt;b&gt;NULL&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="544" width="64" height="20" as="geometry"/></mxCell><mxCell id="t146" value="May be empty. Every other column is NOT NULL." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="544" width="374" height="30" as="geometry"/></mxCell><mxCell id="t147" value="&lt;b&gt;= x&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="box106"><mxGeometry x="16" y="568" width="64" height="20" as="geometry"/></mxCell><mxCell id="t148" value="Default value. CHECK = only listed values allowed." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="80" y="568" width="374" height="30" as="geometry"/></mxCell><mxCell id="t149" value="&lt;b&gt;4. Inheritance (class table)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="box106"><mxGeometry x="16" y="600" width="438" height="20" as="geometry"/></mxCell><mxCell id="t150" value="&lt;b&gt;grid_zones&lt;/b&gt; holds what every zone shares (GridZone). Each zone has exactly one extra row in &lt;b&gt;rentable_units&lt;/b&gt; (zone_kind = UNIT) or &lt;b&gt;common_areas&lt;/b&gt; (zone_kind = COMMON) with the same id." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="box106"><mxGeometry x="16" y="624" width="438" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
