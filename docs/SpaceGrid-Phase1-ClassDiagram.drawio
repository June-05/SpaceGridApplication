;entryDy=0;" edge="1" parent="1" source="cls1037" target="cls1031"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend1180" value="Legend" style="swimlane;shape=swimlane;verticalAlign=top;html=1;startSize=30;align=left;spacingLeft=10;fontSize=14;fontStyle=1;fillColor=#333333;fontColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#333333;collapsible=0;" vertex="1" parent="1"><mxGeometry x="4415" y="120" width="560" height="1390" as="geometry"/></mxCell><mxCell id="t1181" value="&lt;b&gt;1. Categories (packages)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="40" width="528" height="20" as="geometry"/></mxCell><mxCell id="t1182" value="&lt;b&gt;model&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="64" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1183" value="Data and rules of the system: entities, enums and value objects. No SQL, no web code." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="64" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1184" value="&lt;b&gt;dao&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="94" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1185" value="Database access. Interfaces say what can be saved or loaded; Jdbc classes run the SQL with JdbcTemplate." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="94" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1186" value="&lt;b&gt;service&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="124" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1187" value="Business rules: ownership checks, lease rules, payment rules. Called by controllers, uses DAOs." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="124" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1188" value="&lt;b&gt;controller&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="154" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1189" value="Web API for the HTML pages. Reads the request, calls one service method, returns JSON." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="154" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1190" value="&lt;b&gt;security&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="184" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1191" value="Password hashing and tracking who is logged in." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="184" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1192" value="&lt;b&gt;payment&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="214" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1193" value="The payment step, hidden behind an interface. FakePaymentGateway simulates GCash, Maya and Card." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="214" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1194" value="&lt;b&gt;exception&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="244" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1195" value="Custom error types and the handler that turns them into JSON error messages." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="244" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1196" value="&lt;b&gt;(root)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="274" width="96" height="30" as="geometry"/></mxCell><mxCell id="t1197" value="Entry point that starts Spring Boot." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="274" width="432" height="30" as="geometry"/></mxCell><mxCell id="t1198" value="&lt;b&gt;2. Class kinds (header color + «stereotype»)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="312" width="528" height="20" as="geometry"/></mxCell><mxCell id="r1199" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="338" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1200" value="&lt;b&gt;«entity»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="336" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1201" value="Saved in the database and has an id. Its data can change, but it stays the same thing." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="336" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1202" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="370" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1203" value="&lt;b&gt;«abstract»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="368" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1204" value="A parent class that can't be created on its own. Name and abstract methods are in italics." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="368" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1205" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="402" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1206" value="&lt;b&gt;«value object»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="400" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1207" value="Defined only by its values, has no id and never changes after it is created." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="400" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1208" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="434" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1209" value="&lt;b&gt;«enumeration»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="432" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1210" value="A fixed list of allowed values (top part), with optional fields and methods (bottom part)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="432" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1211" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;dashed=1;" vertex="1" parent="legend1180"><mxGeometry x="16" y="466" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1212" value="&lt;b&gt;«interface»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="464" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1213" value="A contract: lists methods that implementing classes must provide." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="464" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1214" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#d4f1f9;strokeColor=#2b8cbe;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="498" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1215" value="&lt;b&gt;«repository» / «implementation»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="496" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1216" value="A class that implements an interface (for DAOs: «repository», the actual SQL)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="496" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1217" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#f8d7e8;strokeColor=#c2185b;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="530" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1218" value="&lt;b&gt;«service»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="528" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1219" value="Holds business rules. Called by controllers, uses DAOs." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="528" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1220" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#eeeeee;strokeColor=#4d4d4d;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="562" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1221" value="&lt;b&gt;«controller»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="560" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1222" value="Receives web requests from the HTML pages. Bottom part lists its URLs." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="560" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1223" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#efebe9;strokeColor=#795548;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="594" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1224" value="&lt;b&gt;«component»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="592" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1225" value="A helper object managed by Spring." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="592" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1226" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="626" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1227" value="&lt;b&gt;«exception» (+ handler)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="624" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1228" value="A custom error type. Each one maps to an HTTP status code." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="624" width="304" height="30" as="geometry"/></mxCell><mxCell id="r1229" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="legend1180"><mxGeometry x="16" y="658" width="26" height="16" as="geometry"/></mxCell><mxCell id="t1230" value="&lt;b&gt;«main»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="52" y="656" width="190" height="30" as="geometry"/></mxCell><mxCell id="t1231" value="Starts the application." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="240" y="656" width="304" height="30" as="geometry"/></mxCell><mxCell id="t1232" value="Every box is a &lt;b&gt;class&lt;/b&gt; except the orange dashed ones, which are &lt;b&gt;interfaces&lt;/b&gt; (contracts that classes implement)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="688" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1233" value="&lt;b&gt;3. Relationships&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="726" width="528" height="20" as="geometry"/></mxCell><mxCell id="le1234" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endSize=14;endFill=0;" edge="1" parent="legend1180"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="759" as="sourcePoint"/><mxPoint x="84" y="759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1235" value="&lt;b&gt;Inheritance (extends)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="100" y="750" width="150" height="30" as="geometry"/></mxCell><mxCell id="t1236" value="Child → parent. The child is a kind of the parent." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="250" y="750" width="294" height="30" as="geometry"/></mxCell><mxCell id="le1237" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endSize=14;endFill=0;dashed=1;" edge="1" parent="legend1180"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="791" as="sourcePoint"/><mxPoint x="84" y="791" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1238" value="&lt;b&gt;Implements&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="100" y="782" width="150" height="30" as="geometry"/></mxCell><mxCell id="t1239" value="Class → interface it implements." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="250" y="782" width="294" height="30" as="geometry"/></mxCell><mxCell id="le1240" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;" edge="1" parent="legend1180"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="823" as="sourcePoint"/><mxPoint x="84" y="823" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1241" value="&lt;b&gt;Composition&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="100" y="814" width="150" height="30" as="geometry"/></mxCell><mxCell id="t1242" value="◆ whole owns the part; the part is deleted with it." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="250" y="814" width="294" height="30" as="geometry"/></mxCell><mxCell id="le1243" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="legend1180"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="855" as="sourcePoint"/><mxPoint x="84" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1244" value="&lt;b&gt;Association&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="100" y="846" width="150" height="30" as="geometry"/></mxCell><mxCell id="t1245" value="Has an attribute of / refers to that type. Numbers = multiplicity." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="250" y="846" width="294" height="30" as="geometry"/></mxCell><mxCell id="le1246" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="legend1180"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="887" as="sourcePoint"/><mxPoint x="84" y="887" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1247" value="&lt;b&gt;Dependency (uses)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="100" y="878" width="150" height="30" as="geometry"/></mxCell><mxCell id="t1248" value="Calls or receives that class, but doesn't own it." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="250" y="878" width="294" height="30" as="geometry"/></mxCell><mxCell id="t1249" value="Multiplicity: &lt;b&gt;1&lt;/b&gt; exactly one · &lt;b&gt;0..1&lt;/b&gt; zero or one · &lt;b&gt;0..*&lt;/b&gt; any number · &lt;b&gt;1..*&lt;/b&gt; at least one." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="910" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1250" value="&lt;b&gt;4. Notation inside a class&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="946" width="528" height="20" as="geometry"/></mxCell><mxCell id="t1251" value="&lt;b&gt;+&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="970" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1252" value="public" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="970" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1253" value="&lt;b&gt;-&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="990" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1254" value="private" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="990" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1255" value="&lt;b&gt;#&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1010" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1256" value="protected (subclasses only)" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="1010" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1257" value="&lt;b&gt;~&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1030" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1258" value="package-private (same package only)" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="1030" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1259" value="&lt;b&gt;underlined&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1050" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1260" value="static member / constant" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="1050" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1261" value="&lt;b&gt;italic&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1070" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1262" value="abstract class or method" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="1070" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1263" value="&lt;b&gt;{final}&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1090" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1264" value="can't change after creation" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="1090" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1265" value="&lt;b&gt;{readOnly}&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1110" width="96" height="18" as="geometry"/></mxCell><mxCell id="t1266" value="filled by the DAO for display, never saved" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="112" y="1110" width="432" height="18" as="geometry"/></mxCell><mxCell id="t1267" value="&lt;b&gt;5. Left out to keep the diagram readable&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1140" width="528" height="20" as="geometry"/></mxCell><mxCell id="t1268" value="• Getters for every field (all fields have one; there are no public setters)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1164" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1269" value='• The second "from database" constructor of each entity (takes id and createdAt).' style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1194" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1270" value="• equals() / hashCode() on value objects (compare by values)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1224" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1271" value="• Constructors of services, controllers and DAOs: Spring passes the listed fields in (dependency injection)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1254" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1272" value="• Controllers: every method also receives HttpSession; parameter types match the service methods." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1284" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1273" value="• Lines from services/DAOs to the model classes they use, and to the exceptions they throw." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1314" width="528" height="30" as="geometry"/></mxCell><mxCell id="t1274" value="• Every controller also uses SessionManager (one line per controller would cross the whole page, so they are not drawn)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend1180"><mxGeometry x="16" y="1344" width="528" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
