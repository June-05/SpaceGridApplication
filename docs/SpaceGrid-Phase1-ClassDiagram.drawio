ight="18" as="geometry"/></mxCell><mxCell id="t264" value="filled by the DAO for display, never saved" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="1110" width="432" height="18" as="geometry"/></mxCell><mxCell id="t265" value="&lt;b&gt;5. Left out to keep the diagram readable&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1140" width="528" height="20" as="geometry"/></mxCell><mxCell id="t266" value="• Getters for every field (all fields have one; there are no public setters)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1164" width="528" height="30" as="geometry"/></mxCell><mxCell id="t267" value='• The second "from database" constructor of each entity (takes id and createdAt).' style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1194" width="528" height="30" as="geometry"/></mxCell><mxCell id="t268" value="• equals() / hashCode() on value objects (compare by values)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1224" width="528" height="30" as="geometry"/></mxCell><mxCell id="t269" value="• Constructors of services, controllers and DAOs: Spring passes the listed fields in (dependency injection)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1254" width="528" height="30" as="geometry"/></mxCell><mxCell id="t270" value="• Controllers: every method also receives HttpSession; parameter types match the service methods." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1284" width="528" height="30" as="geometry"/></mxCell><mxCell id="t271" value="• Lines from services/DAOs to the model classes they use, and to the exceptions they throw." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1314" width="528" height="30" as="geometry"/></mxCell><mxCell id="t272" value="• Enum and value-object links show which class uses them. RentDue and PaymentResult are created by PaymentService and FakePaymentGateway (see page 2)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="1344" width="528" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Application Layers" id="layers"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1039" value="&lt;b&gt;SpaceGrid · Class Diagram · Page 2: Application Layers&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t1040" value="How a request flows: controller → service → DAO → MySQL. Model classes are on page 1." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1400" height="22" as="geometry"/></mxCell><mxCell id="pkg1041" value='&lt;b&gt;«package» com.techhub.spacegridapplication&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style="font-weight:normal;font-size:11px;color:#555555"&gt;Entry point that starts Spring Boot.&lt;/span&gt;' style="swimlane;shape=swimlane;verticalAlign=top;fontColor=#1a1a1a;html=1;startSize=30;horizontal=1;align=left;spacingLeft=10;fontSize=13;fontStyle=0;fillColor=#e9e9e9;swimlaneFillColor=#fafafa;strokeColor=#9e9e9e;collapsible=0;rounded=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="514" height="138" as="geometry"/></mxCell><mxCell id="cls1038" value='&lt;span style="font-weight:normal;font-size:11px"&gt;«main»&lt;/span&gt;&lt;br&gt;&lt;b&gt;SpaceGridApplication&lt;/b&gt;' style="swimlane;shape=swimlane;fontColor=#1a1a1a;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="pkg1041"><mxGeometry x="30" y="45" width="220" height="68" as="geometry"/></mxCell><mxCell id="txt1042" value='&lt;div style="line-height:14px"&gt;&lt;u&gt;+ main(args: String[]): void&lt;/u&gt;&lt;/div&gt;' style="text;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="cls1038"><mxGeometry y="44" width="220" height="24" as="geometry"/></mxCell><mxCell id="pkg1043" value='&lt;b&gt;«package» controller&lt;/b&gt;&am