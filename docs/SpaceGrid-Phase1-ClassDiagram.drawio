11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="64" width="432" height="30" as="geometry"/></mxCell><mxCell id="t182" value="&lt;b&gt;dao&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="94" width="96" height="30" as="geometry"/></mxCell><mxCell id="t183" value="Database access. Interfaces say what can be saved or loaded; Jdbc classes run the SQL with JdbcTemplate." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="94" width="432" height="30" as="geometry"/></mxCell><mxCell id="t184" value="&lt;b&gt;service&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="124" width="96" height="30" as="geometry"/></mxCell><mxCell id="t185" value="Business rules: ownership checks, lease rules, payment rules. Called by controllers, uses DAOs." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="124" width="432" height="30" as="geometry"/></mxCell><mxCell id="t186" value="&lt;b&gt;controller&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="154" width="96" height="30" as="geometry"/></mxCell><mxCell id="t187" value="Web API for the HTML pages. Reads the request, calls one service method, returns JSON." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="154" width="432" height="30" as="geometry"/></mxCell><mxCell id="t188" value="&lt;b&gt;security&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="184" width="96" height="30" as="geometry"/></mxCell><mxCell id="t189" value="Password hashing and tracking who is logged in." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="184" width="432" height="30" as="geometry"/></mxCell><mxCell id="t190" value="&lt;b&gt;payment&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="214" width="96" height="30" as="geometry"/></mxCell><mxCell id="t191" value="The payment step, hidden behind an interface. FakePaymentGateway simulates GCash, Maya and Card." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="214" width="432" height="30" as="geometry"/></mxCell><mxCell id="t192" value="&lt;b&gt;exception&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="244" width="96" height="30" as="geometry"/></mxCell><mxCell id="t193" value="Custom error types and the handler that turns them into JSON error messages." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="244" width="432" height="30" as="geometry"/></mxCell><mxCell id="t194" value="&lt;b&gt;(root)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="274" width="96" height="30" as="geometry"/></mxCell><mxCell id="t195" value="Entry point that starts Spring Boot." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="274" width="432" height="30" as="geometry"/></mxCell><mxCell id="t196" value="&lt;b&gt;2. Class kinds (header color + «stereotype»)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="312" width="528" height="20" as="geometry"/></mxCell><mxCell id="r197" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="338" width="26" height="16" as="geometry"/></mxCell><mxCell id="t198" value="&lt;b&gt;«entity»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="336" width="190" height="30" as="geometry"/></mxCell><mxCell id="t199" value="Saved in the database and has an id. Its data can change, but it stays the same thing." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="336" width="304" height="30" as="geometry"/></mxCell><mxCell id="r200" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="370" width="26" height="16" as="geometry"/></mxCell><mxCell id="t201" value="&lt;b&gt;«abstract»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="368" width="190" height="30" as="geometry"/></mxCell><mxCell id="t202" value="A parent class that can't be created on its own. Name and abstract methods are in italics." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="368" width="304" height="30" as="geometry"/></mxCell><mxCell id="r203" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="402" width="26" height="16" as="geometry"/></mxCell><mxCell id="t204" value="&lt;b&gt;«value object»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="400" width="190" height="30" as="geometry"/></mxCell><mxCell id="t205" value="Defined only by its values, has no id and never changes after it is created." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="400" width="304" height="30" as="geometry"/></mxCell><mxCell id="r206" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="434" width="26" height="16" as="geometry"/></mxCell><mxCell id="t207" value="&lt;b&gt;«enumeration»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="432" width="190" height="30" as="geometry"/></mxCell><mxCell id="t208" value="A fixed list of allowed values (top part), with optional fields and methods (bottom part)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="432" width="304" height="30" as="geometry"/></mxCell><mxCell id="r209" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;dashed=1;" vertex="1" parent="legend178"><mxGeometry x="16" y="466" width="26" height="16" as="geometry"/></mxCell><mxCell id="t210" value="&lt;b&gt;«interface»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="464" width="190" height="30" as="geometry"/></mxCell><mxCell id="t211" value="A contract: lists methods that implementing classes must provide." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="464" width="304" height="30" as="geometry"/></mxCell><mxCell id="r212" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#d4f1f9;strokeColor=#2b8cbe;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="498" width="26" height="16" as="geometry"/></mxCell><mxCell id="t213" value="&lt;b&gt;«repository» / «implementation»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="496" width="190" height="30" as="geometry"/></mxCell><mxCell id="t214" value="A class that implements an interface (for DAOs: «repository», the actual SQL)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="496" width="304" height="30" as="geometry"/></mxCell><mxCell id="r215" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#f8d7e8;strokeColor=#c2185b;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="530" width="26" height="16" as="geometry"/></mxCell><mxCell id="t216" value="&lt;b&gt;«service»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="528" width="190" height="30" as="geometry"/></mxCell><mxCell id="t217" value="Holds business rules. Called by controllers, uses DAOs." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="528" width="304" height="30" as="geometry"/></mxCell><mxCell id="r218" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#eeeeee;strokeColor=#4d4d4d;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="562" width="26" height="16" as="geometry"/></mxCell><mxCell id="t219" value="&lt;b&gt;«controller»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="560" width="190" height="30" as="geometry"/></mxCell><mxCell id="t220" value="Receives web requests from the HTML pages. Bottom part lists its URLs." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="560" width="304" height="30" as="geometry"/></mxCell><mxCell id="r221" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#efebe9;strokeColor=#795548;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="594" width="26" height="16" as="geometry"/></mxCell><mxCell id="t222" value="&lt;b&gt;«component»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="592" width="190" height="30" as="geometry"/></mxCell><mxCell id="t223" value="A helper object managed by Spring." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="592" width="304" height="30" as="geometry"/></mxCell><mxCell id="r224" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="626" width="26" height="16" as="geometry"/></mxCell><mxCell id="t225" value="&lt;b&gt;«exception» (+ handler)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="624" width="190" height="30" as="geometry"/></mxCell><mxCell id="t226" value="A custom error type. Each one maps to an HTTP status code." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="624" width="304" height="30" as="geometry"/></mxCell><mxCell id="r227" value="" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="legend178"><mxGeometry x="16" y="658" width="26" height="16" as="geometry"/></mxCell><mxCell id="t228" value="&lt;b&gt;«main»&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="52" y="656" width="190" height="30" as="geometry"/></mxCell><mxCell id="t229" value="Starts the application." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="240" y="656" width="304" height="30" as="geometry"/></mxCell><mxCell id="t230" value="Every box is a &lt;b&gt;class&lt;/b&gt; except the orange dashed ones, which are &lt;b&gt;interfaces&lt;/b&gt; (contracts that classes implement)." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="688" width="528" height="30" as="geometry"/></mxCell><mxCell id="t231" value="&lt;b&gt;3. Relationships&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="726" width="528" height="20" as="geometry"/></mxCell><mxCell id="le232" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endSize=14;endFill=0;" edge="1" parent="legend178"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="759" as="sourcePoint"/><mxPoint x="84" y="759" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t233" value="&lt;b&gt;Inheritance (extends)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="100" y="750" width="150" height="30" as="geometry"/></mxCell><mxCell id="t234" value="Child → parent. The child is a kind of the parent." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="250" y="750" width="294" height="30" as="geometry"/></mxCell><mxCell id="le235" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=block;endSize=14;endFill=0;dashed=1;" edge="1" parent="legend178"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="791" as="sourcePoint"/><mxPoint x="84" y="791" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t236" value="&lt;b&gt;Implements&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="100" y="782" width="150" height="30" as="geometry"/></mxCell><mxCell id="t237" value="Class → interface it implements." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="250" y="782" width="294" height="30" as="geometry"/></mxCell><mxCell id="le238" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=16;endArrow=open;endSize=10;" edge="1" parent="legend178"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="823" as="sourcePoint"/><mxPoint x="84" y="823" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t239" value="&lt;b&gt;Composition&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="100" y="814" width="150" height="30" as="geometry"/></mxCell><mxCell id="t240" value="◆ whole owns the part; the part is deleted with it." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="250" y="814" width="294" height="30" as="geometry"/></mxCell><mxCell id="le241" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;" edge="1" parent="legend178"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="855" as="sourcePoint"/><mxPoint x="84" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t242" value="&lt;b&gt;Association&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="100" y="846" width="150" height="30" as="geometry"/></mxCell><mxCell id="t243" value="Has an attribute of / refers to that type. Numbers = multiplicity." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="250" y="846" width="294" height="30" as="geometry"/></mxCell><mxCell id="le244" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;strokeColor=#555555;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;" edge="1" parent="legend178"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="887" as="sourcePoint"/><mxPoint x="84" y="887" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t245" value="&lt;b&gt;Dependency (uses)&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="100" y="878" width="150" height="30" as="geometry"/></mxCell><mxCell id="t246" value="Calls or receives that class, but doesn't own it." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="250" y="878" width="294" height="30" as="geometry"/></mxCell><mxCell id="t247" value="Multiplicity: &lt;b&gt;1&lt;/b&gt; exactly one · &lt;b&gt;0..1&lt;/b&gt; zero or one · &lt;b&gt;0..*&lt;/b&gt; any number · &lt;b&gt;1..*&lt;/b&gt; at least one." style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="910" width="528" height="30" as="geometry"/></mxCell><mxCell id="t248" value="&lt;b&gt;4. Notation inside a class&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="16" y="946" width="528" height="20" as="geometry"/></mxCell><mxCell id="t249" value="&lt;b&gt;+&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="970" width="96" height="18" as="geometry"/></mxCell><mxCell id="t250" value="public" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="970" width="432" height="18" as="geometry"/></mxCell><mxCell id="t251" value="&lt;b&gt;-&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="990" width="96" height="18" as="geometry"/></mxCell><mxCell id="t252" value="private" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="990" width="432" height="18" as="geometry"/></mxCell><mxCell id="t253" value="&lt;b&gt;#&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="1010" width="96" height="18" as="geometry"/></mxCell><mxCell id="t254" value="protected (subclasses only)" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="1010" width="432" height="18" as="geometry"/></mxCell><mxCell id="t255" value="&lt;b&gt;~&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;fontFamily=Courier New;" vertex="1" parent="legend178"><mxGeometry x="16" y="1030" width="96" height="18" as="geometry"/></mxCell><mxCell id="t256" value="package-private (same package only)" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=0;" vertex="1" parent="legend178"><mxGeometry x="112" y="1030" width="432" height="18" as="geometry"/></mxCell><mxCell id="t257" value="&lt;b&gt;underlined&lt;/b&gt;" style="text;html=1;fontColor=#1a1a1a;strokeColor=none;fillColor=none;align=left;ve